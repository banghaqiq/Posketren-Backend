# Database connection string (MySQL)
DATABASE_URL="mysql://username:password@localhost:3306/njpackage"

# JWT Secret (Generate a strong 32+ character random secret for production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"

# Port
PORT=8080

# Allowed Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# Node Environment ('development' or 'production')
NODE_ENV="development"

